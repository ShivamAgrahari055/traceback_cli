# ---------------------------------------------------------------
# TraceBack configuration
# ---------------------------------------------------------------
# Local-first by default. Nothing is transmitted externally.

# Path to the SQLite history database (relative or absolute)
TRACEBACK_DB_PATH=traceback_history.db

# Assume UTC for timezone-naive timestamps when true
TRACEBACK_ASSUME_UTC=true

# Redact email addresses in addition to credentials/tokens
TRACEBACK_REDACT_EMAILS=true

# ---------------------------------------------------------------
# Optional AI layer (disabled by default)
# The application is fully functional without any AI provider.
# ---------------------------------------------------------------
TRACEBACK_AI_ENABLED=false
TRACEBACK_AI_PROVIDER=gemini
TRACEBACK_AI_API_KEY=
TRACEBACK_AI_MODEL=gemini-pro
TRACEBACK_AI_BASE_URL=